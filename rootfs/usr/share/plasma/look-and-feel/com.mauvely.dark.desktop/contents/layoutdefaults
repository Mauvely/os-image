# The window settings this preset carries. mauvely-session applies them after
# it applies the preset, since Plasma 6.7's plasma-apply-lookandfeel applies
# no layoutdefaults. The layout script writes the same keys, for System
# Settings' own switch: change both together.
[kwinrc][org.kde.kdecoration2]
ButtonsOnLeft=
ButtonsOnRight=IAX

[breezerc][Common]
CornerRadius=8

[breezerc][Style]
MenuOpacity=70
