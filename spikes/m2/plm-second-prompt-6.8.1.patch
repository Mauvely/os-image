+void Display::respond(QLocalSocket *socket, const QString &answer)
+{
+    // Only the answer to a question asked just now, and only from the greeter that was asked.
+    if (!m_challengePending || socket != m_socket) {
+        return;
+    }
+    m_challengePending = false;
+
+    const QList<AuthPrompt *> prompts = m_auth->request()->prompts();
+    if (prompts.length() == 1) {
+        prompts[0]->setResponse(answer.toLocal8Bit());
+        m_auth->request()->done();
+    }
+}
+
 bool Display::startAuth(const QString &user, const QString &password, const Session &session)
 {
     qDebug() << "start auth" << "user" << session.isValid() << session.exec();
@@ -296,6 +312,8 @@ bool Display::startAuth(const QString &user, const QString &password, const Sess
 
 void Display::slotAuthenticationFinished(const QString &user, bool success)
 {
+    m_challengePending = false;
+
     if (m_auth->autologin() && !success) {
         handleAutologinFailure();
         return;
@@ -357,6 +375,19 @@ void Display::slotHelperFinished(Auth::HelperExitStatus status)
 
 void Display::slotRequestChanged()
 {
+    const QList<AuthPrompt *> prompts = m_auth->request()->prompts();
+    if (prompts.length() == 1 && prompts[0]->type() == AuthPrompt::LOGIN_CHALLENGE) {
+        // A PAM module asks something that is not the password: a code, a PIN. Ask the person.
+        // With nobody to ask, as in autologin, answer nothing and let the module refuse.
+        if (!m_socket) {
+            m_auth->request()->done();
+            return;
+        }
+        m_challengePending = true;
+        m_socketServer->prompt(m_socket, prompts[0]->message(), prompts[0]->hidden());
+        return;
+    }
+
     if (m_auth->request()->prompts().length() == 1) {
         m_auth->request()->prompts()[0]->setResponse(qPrintable(m_passPhrase));
         m_auth->request()->done();
