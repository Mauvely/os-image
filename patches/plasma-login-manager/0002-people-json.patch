+/*
+ * SPDX-FileCopyrightText: 2026 Mauvely
+ *
+ * SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <QObject>
+#include <QString>
+
+/*
+ * Who signs in on this device, as its management agent wrote it:
+ *
+ *   {"mode": "shared" | "assigned",
+ *    "assigned": {"username": "...", "name": "..."} | null,
+ *    "org": {"name": "...", "slug": "..."}}
+ *
+ * Shared: no user list, a username field. Assigned: the assigned person alone,
+ * and "Other…" for anyone else. With no file, or one that cannot be read, the
+ * greeter is unchanged.
+ */
+class DevicePeople : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(QString organisation READ organisation CONSTANT)
+
+public:
+    enum class Mode {
+        Unmanaged,
+        Shared,
+        Assigned,
+    };
+
+    explicit DevicePeople(const QString &path, QObject *parent = nullptr);
+
+    Mode mode() const;
+    QString assignedUser() const;
+    QString assignedName() const;
+    QString organisation() const;
+
+private:
+    Mode m_mode = Mode::Unmanaged;
+    QString m_assignedUser;
+    QString m_assignedName;
+    QString m_organisation;
+};
