diff --git a/src/frontend/greeter/devicepeople.cpp b/src/frontend/greeter/devicepeople.cpp
new file mode 100644
index 0000000..fee6cf0
--- /dev/null
+++ b/src/frontend/greeter/devicepeople.cpp
@@ -0,0 +1,80 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mauvely
+ *
+ * SPDX-License-Identifier: LGPL-2.0-or-later
+ */
+
+#include "devicepeople.h"
+
+#include <QDebug>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+
+DevicePeople::DevicePeople(const QString &path, QObject *parent)
+    : QObject(parent)
+{
+    if (path.isEmpty()) {
+        return;
+    }
+
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        // No file: a device nobody manages, shown as it always was
+        return;
+    }
+
+    QJsonParseError error;
+    const QJsonDocument document = QJsonDocument::fromJson(file.read(64 * 1024), &error);
+    if (!document.isObject()) {
+        qWarning() << "Ignoring" << path << error.errorString();
+        return;
+    }
+    const QJsonObject root = document.object();
+
+    m_organisation = root.value(QLatin1String("org")).toObject().value(QLatin1String("name")).toString().simplified().left(80);
+
+    const QString mode = root.value(QLatin1String("mode")).toString();
+    if (mode == QLatin1String("shared")) {
+        m_mode = Mode::Shared;
+    } else if (mode == QLatin1String("assigned")) {
+        const QJsonObject assigned = root.value(QLatin1String("assigned")).toObject();
+        const QString user = assigned.value(QLatin1String("username")).toString();
+        // systemd's strict rule for user names
+        static const QRegularExpression valid(QStringLiteral("^[A-Za-z_][A-Za-z0-9_-]{0,30}$"));
+        if (valid.match(user).hasMatch()) {
+            m_mode = Mode::Assigned;
+            m_assignedUser = user;
+            m_assignedName = assigned.value(QLatin1String("name")).toString().simplified().left(80);
+        } else {
+            // Assigned to nobody this greeter can show: ask for a name, as on a shared device
+            m_mode = Mode::Shared;
+        }
+    } else {
+        qWarning() << "Ignoring" << path << "with mode" << mode;
+        m_organisation.clear();
+    }
+}
+
+DevicePeople::Mode DevicePeople::mode() const
+{
+    return m_mode;
+}
+
+QString DevicePeople::assignedUser() const
+{
+    return m_assignedUser;
+}
+
+QString DevicePeople::assignedName() const
+{
+    return m_assignedName;
+}
+
+QString DevicePeople::organisation() const
+{
+    return m_organisation;
+}
+
+#include "moc_devicepeople.cpp"
