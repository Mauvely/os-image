@@ -82,6 +82,24 @@ int UserModel::indexOfData(const QVariant &data, int role) const
     return -1;
 }
 
+void UserModel::showOnly(const QString &name, const QString &realName)
+{
+    beginResetModel();
+
+    QList<User> kept;
+    for (const User &user : std::as_const(m_users)) {
+        if (!name.isEmpty() && user.name == name) {
+            kept << user;
+        }
+    }
+    if (!name.isEmpty() && kept.isEmpty()) {
+        kept << User(name, realName, QStringLiteral("qrc:/qt/qml/org/kde/plasma/login/.face.icon"), QString(), true, -1, -1);
+    }
+    m_users = kept;
+
+    endResetModel();
+}
+
 void UserModel::populate()
 {
     beginResetModel();
